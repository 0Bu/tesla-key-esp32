{
  "permissions": {"allow": []},
  "hooks": {
    "SessionStart": [{"hooks": [
      {"type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/report-capabilities.sh\"", "statusMessage": "Detecting repository capabilities…", "timeout": 15},
      {"type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/build-efficiency-check.sh\"", "statusMessage": "Loading read-only build-efficiency context…", "timeout": 15}
    ]}],
    "SubagentStart": [{"hooks": [
      {"type": "command", "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/tools/agent-hooks/agent_hook.py\" subagent-context", "statusMessage": "Loading repository and authorization boundaries…", "timeout": 10}
    ]}],
    "Stop": [{"hooks": [
      {"type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/run-logic-tests.sh\"", "statusMessage": "Running changed host logic tests…", "timeout": 600}
    ]}],
    "PreToolUse": [
      {"matcher": "^(?:Read|Edit|MultiEdit|Write|Bash)$", "hooks": [
        {"type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard-secrets.sh\"", "statusMessage": "Checking secret and partition safety…", "timeout": 15}
      ]},
      {"matcher": "^(?:Bash|mcp__.*(?:github|GitHub).*)$", "hooks": [
        {"type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/require-project-review.sh\"", "statusMessage": "Checking current PR policy evidence…", "timeout": 180}
      ]}
    ],
    "PostToolUse": [{"matcher": "^(?:Edit|MultiEdit|Write)$", "hooks": [
      {"type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/clang-format-edit.sh\"", "statusMessage": "Formatting edited first-party C/C++…", "timeout": 30}
    ]}]
  }
}
