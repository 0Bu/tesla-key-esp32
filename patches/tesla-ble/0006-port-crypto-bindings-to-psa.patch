+// The 16-byte session key K as a short-lived AES-128-GCM key in the PSA key store.
+psa_status_t import_session_key(const pb_byte_t *key, psa_key_usage_t usage, mbedtls_svc_key_id_t *key_id) {
+  psa_key_attributes_t attributes = PSA_KEY_ATTRIBUTES_INIT;
+  psa_set_key_type(&attributes, PSA_KEY_TYPE_AES);
+  psa_set_key_bits(&attributes, 128);
+  psa_set_key_usage_flags(&attributes, usage);
+  psa_set_key_algorithm(&attributes, PSA_ALG_GCM);
+  psa_status_t status = psa_import_key(&attributes, key, 16, key_id);
+  psa_reset_key_attributes(&attributes);
+  return status;
+}
+
+// AAD = SHA256(metadata TLV buffer), per the Tesla protocol
+psa_status_t hash_ad_buffer(const pb_byte_t *ad_buffer, size_t ad_length, unsigned char ad_hash[32]) {
+  size_t hash_length = 0;
+  psa_status_t status = psa_hash_compute(PSA_ALG_SHA_256, ad_buffer, ad_length, ad_hash, 32, &hash_length);
+  if (status == PSA_SUCCESS && hash_length != 32) {
+    status = PSA_ERROR_GENERIC_ERROR;
+  }
+  return status;
+}
