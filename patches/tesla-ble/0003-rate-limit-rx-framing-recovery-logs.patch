@@ -309,0 +311,3 @@
+  std::chrono::steady_clock::time_point last_rx_recovery_warning_log_{};
+  std::chrono::steady_clock::time_point last_rx_recovery_error_log_{};
+  uint32_t suppressed_rx_recovery_logs_{0};
@@ -340,0 +345 @@
