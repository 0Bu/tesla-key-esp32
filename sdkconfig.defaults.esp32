# Classic-ESP32-only overrides, merged on top of sdkconfig.defaults when
# `idf.py set-target esp32` is run (ESP-IDF auto-applies sdkconfig.defaults.<target>).
#
# The Secure Boot v2 RSA-3072 signature scheme used for signed OTA
# (CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME, see sdkconfig.defaults) is only available on the
# classic ESP32 from chip revision v3.0 (ECO3) onward. Require it so the one signing scheme +
# one signing key serves every target uniformly. Trade-off: signed firmware will refuse to
# boot on pre-ECO3 (rev v0/v1) ESP32 silicon — those boards must use an ECO3 chip (standard
# since ~2020). The other targets (s3/c3/c6) support V2 RSA at their default min revision, so
# they need no equivalent override. Documented in docs/SECURITY.md.
CONFIG_ESP32_REV_MIN_3=y

# ── INTERNAL RAM budget for OTA (docs/ARCHITECTURE.md#ota-self-update) ──
# Without the settings below a running classic esp32 keeps less INTERNAL largest block than the
# shared recovery threshold (logic/ota_recovery_memory.hpp) requires: it can neither start an OTA
# nor confirm one. Its IRAM is a separate region, so moving code out of IRAM frees no heap here;
# NimBLE already returns the classic-BT controller memory in BLE-only mode.
# One BLE connection: the controller reserves 1 KB static DRAM per configured connection.
CONFIG_BTDM_CTRL_BLE_MAX_CONN=1
# Half of NimBLE's large 320-B msys blocks; the inbound ACL and HCI event pools keep their
# defaults because one vehicle frame arrives as up to ~100 notifications at ATT MTU 23.
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=12
# Static WiFi RX buffers (~1.6 KB each, allocated at esp_wifi_init) kept at the RX BA window.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
# Half of the default /diag console ring (static .bss); Syslog keeps the longer history.
CONFIG_TESLA_DIAG_LOG_BYTES=8192
