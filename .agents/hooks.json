{
  "capabilities": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 \"$(git rev-parse --show-toplevel)/tools/agent-hooks/agent_hook.py\" antigravity-pre-invocation",
        "statusMessage": "Detecting repository capabilities",
        "timeout": 15
      }
    ]
  },
  "pre-tool-guards": {
    "PreToolUse": [
      {
        "matcher": "^(?:run_command|view_file|replace_file_content|write_to_file|apply_patch|Read|Edit|MultiEdit|Write|Bash|exec_command|shell|shell_command)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/tools/agent-hooks/agent_hook.py\" pre-tool-guards",
            "statusMessage": "Checking secret and partition safety",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "^(?:run_command|Bash|exec_command|shell|shell_command|mcp__.*(?:github|GitHub).*)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/tools/agent-hooks/require-pr-gates.sh\"",
            "statusMessage": "Checking current PR policy evidence",
            "timeout": 180
          }
        ]
      }
    ]
  },
  "post-tool-formatter": {
    "PostToolUse": [
      {
        "matcher": "^(?:replace_file_content|write_to_file|apply_patch|Edit|MultiEdit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/tools/agent-hooks/agent_hook.py\" format",
            "statusMessage": "Formatting edited first-party C and C++",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "stop-tests": {
    "Stop": [
      {
        "type": "command",
        "command": "python3 \"$(git rev-parse --show-toplevel)/tools/agent-hooks/agent_hook.py\" stop-logic-tests",
        "statusMessage": "Running changed host logic tests",
        "timeout": 600
      }
    ]
  }
}
