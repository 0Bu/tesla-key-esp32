{
  "pre-tool-guards": {
    "PreToolUse": [
      {
        "matcher": "^(?:run_command|view_file|replace_file_content|write_to_file|read_file|edit_file|write_file|apply_patch|Read|Edit|MultiEdit|Write|Bash|exec_command|shell|shell_command)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/tools/agent-hooks/agent_hook.py\" pre-tool-guards",
            "statusMessage": "Checking secret and partition safety",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "^(?:run_command|Bash|exec_command|shell|shell_command|mcp__.*(?:github|GitHub).*)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/with-host-python.sh\" python3 \"$(git rev-parse --show-toplevel)/tools/agent-config/codex_hook.py\" AntigravityPR || printf '%s\\n' '{\"decision\":\"deny\",\"reason\":\"Project hook bootstrap failed\"}'",
            "statusMessage": "Checking current PR policy evidence",
            "timeout": 200
          }
        ]
      }
    ]
  }
}
