{
  "description": "Generated by tools/agent-config/sync-codex.mjs from .agents; review and trust in Codex before use.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/with-host-python.sh\" python3 \"$(git rev-parse --show-toplevel)/tools/agent-config/codex_hook.py\" SessionStart",
            "timeout": 20,
            "statusMessage": "Detecting repository capabilities"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/with-host-python.sh\" python3 \"$(git rev-parse --show-toplevel)/tools/agent-config/codex_hook.py\" SubagentStart",
            "timeout": 15,
            "statusMessage": "Loading repository reviewer boundaries"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(?:(?:run_command|view_file|replace_file_content|write_to_file|apply_patch|Read|Edit|MultiEdit|Write|Bash|exec_command|shell|shell_command)|(?:run_command|Bash|exec_command|shell|shell_command|mcp__.*(?:github|GitHub).*))$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/with-host-python.sh\" python3 \"$(git rev-parse --show-toplevel)/tools/agent-config/codex_hook.py\" PreToolUse || { echo \"Project Codex PreToolUse bootstrap failed; verification is blocked.\" >&2; exit 2; }",
            "timeout": 200,
            "statusMessage": "Checking project safety and current PR evidence"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(?:replace_file_content|write_to_file|apply_patch|Edit|MultiEdit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/with-host-python.sh\" python3 \"$(git rev-parse --show-toplevel)/tools/agent-config/codex_hook.py\" PostToolUse",
            "timeout": 30,
            "statusMessage": "Formatting edited first-party C and C++"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/scripts/with-host-python.sh\" python3 \"$(git rev-parse --show-toplevel)/tools/agent-config/codex_hook.py\" Stop || { echo \"Project Codex Stop bootstrap failed; verification is blocked.\" >&2; exit 2; }",
            "timeout": 600,
            "statusMessage": "Running changed host logic tests"
          }
        ]
      }
    ]
  }
}
