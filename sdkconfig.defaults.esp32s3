# ─── ESP32-S3 overrides (LilyGo T-Dongle-S3 onboard display) ──────────────────
# Loaded automatically by ESP-IDF after sdkconfig.defaults when the target is esp32s3
# (`idf.py set-target esp32s3`). The ONE esp32s3 image serves BOTH the LilyGo T-Dongle-S3
# (drives the onboard 0.96" ST7735) and a generic ESP32-S3 (no panel): display.cpp
# auto-detects the dongle at runtime (its TF-card SD pull-ups) and stays a complete no-op on
# a generic board — no framebuffer, no SPI, no backlight pin driven. So these settings are
# safe for both.
#
# Console over the chip's native USB-Serial/JTAG port. This Kconfig symbol does not exist on the
# classic ESP32, so it belongs in target defaults rather than relying on Kconfig to ignore it.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# NO PSRAM here on purpose. A generic ESP32-S3 may have none, and the T-Dongle-S3's
# framebuffer fits in ~25 KB of internal SRAM (allocated once at boot, before WiFi/BLE
# fragment the heap — the proven pre-#98 path). Keeping SPIRAM off means a generic S3 boots
# byte-for-byte as before; the display code only ever runs on a detected dongle.

# Compile in the onboard ST7735 status display. The pins are restated explicitly rather than
# left to the Kconfig defaults they now match, so the shipped esp32s3 image does not depend on
# a default: T-Dongle-S3 wiring, MOSI3 / SCK5 / CS4 / DC2 / RST1 / BL38.
CONFIG_TESLA_DISPLAY_ENABLED=y
CONFIG_TESLA_DISPLAY_SPI_MOSI=3
CONFIG_TESLA_DISPLAY_SPI_SCK=5
CONFIG_TESLA_DISPLAY_CS=4
CONFIG_TESLA_DISPLAY_DC=2
CONFIG_TESLA_DISPLAY_RST=1
CONFIG_TESLA_DISPLAY_BL=38

# ── Ethernet (W5500 over SPI) — M5Stack ATOMIC PoE Base, Waveshare ESP32-S3-ETH, LilyGO T-ETH-Lite ─
# Compiled in for esp32s3 only. The ONE esp32s3 image serves the T-Dongle-S3 (ST7735 panel), a
# generic ESP32-S3 (neither), and any of several W5500 PoE/Ethernet boards. Each is detected at
# runtime and the others pay only a brief probe: net_eth_probe() reads the W5500's VERSIONR
# register once at boot on each known candidate wiring in turn (main/logic/eth_board.hpp's
# kEthDefaultCandidates[] — M5Stack ATOMIC PoE on SCLK5/CS6/MISO7/MOSI8, Waveshare ESP32-S3-ETH on
# SCLK13/CS14/MISO12/MOSI11, LilyGO T-ETH-Lite on SCLK10/CS9/MISO11/MOSI12), latches the first to
# answer, and frees the SPI bus again when nothing answers. The pins below, when they differ from
# the M5Stack default, are prepended as the primary candidate for a custom build.
#
# The T-Dongle OVERLAPS ON A PIN with the M5Stack default — its panel clock is GPIO5, which is also
# the PoE base's SPI SCLK — so net_eth_probe() refuses to probe once tk::board_is_t_dongle_s3()
# says yes. That shared detector is why the probe is safe to compile in unconditionally here.
#
# NOT enabled for esp32/esp32c3/esp32c6: no board in use has a W5500, and esp32c6 has only ~92 KB
# under the ci-build-all.sh size gate, where growth is quantised to 64 KB Secure-Boot blocks.
CONFIG_TESLA_ETH_ENABLED=y
CONFIG_TESLA_ETH_SPI_SCLK=5
CONFIG_TESLA_ETH_SPI_CS=6
CONFIG_TESLA_ETH_SPI_MISO=7
CONFIG_TESLA_ETH_SPI_MOSI=8
# 20 MHz is what Espressif's own W5500 CI configuration uses; the part is specified far higher,
# but these stack-through headers are short unshielded runs.
CONFIG_TESLA_ETH_SPI_CLOCK_MHZ=20
# The ATOMIC PoE Base routes only SCLK/CS/MISO/MOSI + power — no INT line — so the driver polls.
# ESP-IDF ships a CI configuration for exactly this (sdkconfig.ci.poll_w5500, also 10 ms).
CONFIG_TESLA_ETH_POLL_MS=10
CONFIG_TESLA_ETH_WAIT_S=20
