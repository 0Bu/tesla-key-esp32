# ESP32-S3 overrides, loaded after sdkconfig.defaults for this target.

# Console over the chip's native USB-Serial/JTAG port. This Kconfig symbol does not exist on the
# classic ESP32, so it belongs in target defaults rather than relying on Kconfig to ignore it.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# ── INTERNAL RAM budget for OTA (docs/ARCHITECTURE.md#ota-self-update) ──
# S3 IRAM and DRAM share one region, so code kept in RAM is heap the board never gets. Without the
# settings below a paired, wired S3 can settle below the shared recovery threshold
# (logic/ota_recovery_memory.hpp): it can neither start an OTA nor confirm one. Same set as the C3.
# Run the WiFi hot paths from flash (lower peak WiFi throughput; a wired board does not use them).
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
# Controller features this central/observer firmware never uses: no advertising, no direct test
# mode, no link-layer encryption (host SMP is already off in sdkconfig.defaults).
CONFIG_BT_CTRL_DTM_ENABLE=n
CONFIG_BT_NIMBLE_DTM_MODE_TEST=n
CONFIG_BT_CTRL_BLE_ADV=n
CONFIG_BT_CTRL_BLE_SECURITY_ENABLE=n
# Sized for one connection plus scanning: three controller activities (scan, initiator,
# connection) and half of NimBLE's large 320-B msys blocks. The inbound ACL and HCI event pools keep
# their defaults: at the fallback ATT MTU 23 one vehicle frame arrives as up to ~100 notifications
# (docs/adr/0005-tesla-ble-seam.md).
CONFIG_BT_CTRL_BLE_MAX_ACT=3
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=12
# Static WiFi RX buffers (~1.6 KB each, allocated at esp_wifi_init) kept at the RX BA window.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6

# ── Ethernet (W5500 over SPI) — M5Stack ATOMIC PoE Base and Waveshare ESP32-S3-ETH ─────────────
# Compiled in for esp32s3 only. The ONE esp32s3 image serves the T-Dongle-S3, a
# generic ESP32-S3, and any of several W5500 PoE/Ethernet boards. Each is detected at
# runtime and the others pay only a brief probe: net_eth_probe() reads the W5500's VERSIONR
# register once at boot on each known candidate wiring in turn (main/logic/eth_board.hpp's
# kEthDefaultCandidates[] — M5Stack ATOMIC PoE on SCLK5/CS6/MISO7/MOSI8, Waveshare ESP32-S3-ETH on
# SCLK13/CS14/MISO12/MOSI11), latches the first to answer, and frees the SPI bus again when nothing
# answers. The pins below, when they differ from the M5Stack default, are prepended as the primary
# candidate for a custom build after full-width GPIO validation.
#
# The T-Dongle OVERLAPS ON A PIN with the M5Stack default — its panel clock is GPIO5, which is also
# the PoE base's SPI SCLK — so net_eth_probe() refuses to probe once tk::board_is_t_dongle_s3()
# says yes. The physical panel remains wired even without firmware display support.
#
# NOT enabled for esp32/esp32c3/esp32c6: no board in use has a W5500, and esp32c6 has the least
# headroom under the ci-build-all.sh size gate, where growth is quantised to 64 KB Secure-Boot
# blocks. On ESP-IDF 6 the option exists only here: the espressif/w5500 driver is resolved for
# esp32s3 only (main/idf_component.yml).
CONFIG_TESLA_ETH_ENABLED=y
CONFIG_TESLA_ETH_SPI_SCLK=5
CONFIG_TESLA_ETH_SPI_CS=6
CONFIG_TESLA_ETH_SPI_MISO=7
CONFIG_TESLA_ETH_SPI_MOSI=8
# 20 MHz is what Espressif's own W5500 CI configuration uses; the part is specified far higher,
# but these stack-through headers are short unshielded runs.
CONFIG_TESLA_ETH_SPI_CLOCK_MHZ=20
# The ATOMIC PoE Base routes only SCLK/CS/MISO/MOSI + power — no INT line — so the driver polls.
# Polling is a first-class mode of the espressif/w5500 driver, which accepts exactly one of an
# interrupt GPIO or a poll period (esp_eth_mac_new_w5500).
CONFIG_TESLA_ETH_POLL_MS=10
CONFIG_TESLA_ETH_WAIT_S=20
