#!/usr/bin/env bash
# Admission only. Build and test the committed integration candidate before invoking Git.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

block() { echo "BLOCKED by pre-push: $*" >&2; exit 1; }

branch="$(git symbolic-ref --quiet --short HEAD)" ||
    block 'cannot determine branch from detached HEAD'
head="$(git rev-parse HEAD)"
remote="${1:-origin}"
remote_url="${2:-}"
zero_sha=0000000000000000000000000000000000000000

updates=0
verify=0
while read -r local_ref local_sha remote_ref _remote_sha extra; do
    updates=$((updates + 1))
    [ "$updates" = 1 ] && [ -z "$extra" ] ||
        block 'push exactly one branch at a time'
    case "$remote_ref" in
        refs/heads/main|refs/heads/master|refs/heads/gh-pages|refs/heads/HEAD)
            block "destination $remote_ref is protected"
            ;;
        refs/heads/*) ;;
        *) block 'only branch pushes and branch deletions are supported' ;;
    esac
    if [ "$local_sha" != "$zero_sha" ]; then
        [ "$branch" != main ] && [ "$branch" != master ] &&
            [ "$local_sha" = "$head" ] &&
            [ "$remote_ref" = "refs/heads/$branch" ] &&
            { [ "$local_ref" = "refs/heads/$branch" ] || [ "$local_ref" = HEAD ]; } ||
            block 'push only the verified HEAD to the current feature branch'
        verify=1
    fi
done
[ "$updates" -gt 0 ] || exit 0

[ "$remote" = origin ] || block 'push only to origin'
# shellcheck source=/dev/null
. "$root/tools/agent-hooks/pr-gate-lib.sh"
GATE_PROJ="$root"
gate_origin_is_github && [ "$(gate_repo_slug)" = '0Bu/tesla-key-esp32' ] ||
    block 'origin must be github.com/0Bu/tesla-key-esp32'
if [ -n "$remote_url" ]; then
    [ "$remote_url" = "$(git remote get-url --push origin)" ] ||
        block 'Git push destination differs from the configured origin'
fi

if [ "$verify" = 1 ]; then
    scripts/check-local.sh --verify-receipt
    # Keep publication hygiene before changing the head of an existing public PR.
    python3 - "$root" "$branch" <<'PY' | bash tools/agent-hooks/require-pr-gates.sh
import json
import shlex
import sys

print(json.dumps({
    "tool_name": "exec_command",
    "cwd": sys.argv[1],
    "tool_input": {"cmd": "git push origin " + shlex.quote(sys.argv[2])},
}))
PY
fi
