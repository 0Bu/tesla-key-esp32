# ESP-IDF build output
build/
/build_boundary_*/
/.ccache/
sdkconfig
sdkconfig.old

# IDF Component Manager
managed_components/

# Flash artifacts
*.bin
*.elf
*.map

# …but DO ship the web-installer firmware served by GitHub Pages
!docs/*.bin

# Python
__pycache__/
*.pyc
*.pyo
.venv/

# Editor
.vscode/settings.json
.idea/
*.swp
*~

# The project-review (merge) and skill-audit (PR create/push) gates no longer use on-disk
# markers — their pass-state is a ticked, SHA-stamped checkbox in the PR body itself
# (see tools/agent-hooks/pr-gate-lib.sh). Nothing to ignore for those two gates.

# Per-tree transient hook state.
.codex/.logic-tests-blocked
.codex/.build-efficiency-audited

# Per-user Claude Code overlays. The versioned adapter is .claude/CLAUDE.md, .claude/settings.json,
# .claude/agents/ and .claude/skills/; canonical policy stays in AGENTS.md, .agents/, .codex/ and
# tools/agent-hooks/. These two files are personal, may loosen local behavior, and stay untracked.
.claude/settings.local.json
CLAUDE.local.md

# macOS
.DS_Store

# Sensitive — never commit real credentials
sdkconfig.local
secrets.env
# Vehicle diagnostics can contain VINs and authenticated BLE frames. capture_wake.py writes outside
# the repository by default; keep an explicit local --output from becoming commit-ready as well.
wake-capture-*.log

# OTA / Secure Boot signing keys — the private key lives OFFLINE and, in CI, only ever
# as a transient file written from the OTA_SIGNING_KEY secret. NEVER commit a real key.
*.pem
ota_signing_key.pem

# Mock build variant
/build_mock/

# GitHub Pages site assembled by scripts/build-pages.sh
/_site/

# CI/build staging (all reproducible from committed inputs)
/_unsigned/
/_signed/
/_fw/
/_pr_site/
/dist/
# Second-runner artifacts are downloaded as inert comparison data in protected signer jobs.
/_ci-independent/
