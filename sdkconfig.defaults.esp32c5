# ─── LilyGo T-Dongle-C5 (ESP32-C5HR8) overrides ───────────────────────────────
# Loaded automatically by ESP-IDF after sdkconfig.defaults when the target is
# esp32c5 (`idf.py set-target esp32c5`). Only the deltas the on-device display +
# PSRAM need live here.
#
# Flash size stays 4 MB (from sdkconfig.defaults) on purpose: partitions.csv is
# sized to fill 4 MB so ONE table serves every target — the T-Dongle-C5's 16 MB
# just leaves the top unused. Console (USB-Serial/JTAG) is already set in the base.

# PSRAM: the ESP32-C5HR8 carries 8 MB in-package Quad-SPI PSRAM. Put the display
# framebuffer there and move WiFi/LWIP buffers off the smaller internal SRAM
# (384 KB), relieving the largest-contiguous-block pressure this firmware is
# sensitive to. IGNORE_NOTFOUND keeps a PSRAM-less C5 booting; the display then simply
# disables itself (display.cpp does NOT fall back to internal SRAM on the C5 — grabbing
# 25 KB of its scarce contiguous SRAM could OOM this memory-tight board).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# Drive the onboard 0.96" ST7735 status display (pins default to the T-Dongle-C5
# wiring in main/Kconfig.projbuild: MOSI2 / SCK6 / CS10 / DC3 / RST1 / BL0).
CONFIG_TESLA_DISPLAY_ENABLED=y

# NOTE: this build stays on the base -Og (NO -Os). Whole-build -Os was measured to
# HARD-FREEZE this firmware under evcc+BLE load (rejected "Package B", Issue #106) —
# a physical power-cycle is the only recovery, which is unacceptable. The display +
# PSRAM fit under the OTA slot at -Og because the Package A size levers (merged, #154)
# freed ~64 KB. If future growth pushes the C5 image past the slot again, shave flash
# with more zero-risk levers — do NOT reach for -Os.

# ── Core dump: OFF on this target only ──
# MEASURED, not chosen. esp32c5 is the only build carrying BOTH the on-device display and PSRAM,
# and it was already the largest image with ~28 KB of headroom. Adding the coredump component
# (the flash writer plus the ELF summary parser) pushed the app across a Secure-Boot-v2 64 KB
# rounding boundary — 0x1E1000 -> 0x1F1000, i.e. 2,035,712 B against a 2,031,616 B OTA slot. It did
# not merely trip the early-warning gate; it no longer FIT the slot, so loosening the gate was never
# the answer. The other four targets keep core dumps.
#
# What a C5 still reports after a crash: the reset REASON (esp_reset_reason needs no component and
# no partition), the safe-mode boot counter, the heap trend, and the syslog boot replay — i.e. the
# whole recovery ladder. What it loses is the on-device dump: no crashed-task/PC summary on
# /status.last_crash and nothing to download from GET /coredump, which answers 404 there.
#
# The `coredump` partition still exists in the shared table and simply goes unused on this target —
# one table serves every board, so it costs nothing to leave it there, and re-enabling this is a
# one-line change the day the image has room again.
#
# TO REVISIT: find ~64 KB elsewhere on this target and delete this block. Whole-build -Os is NOT
# the lever (it hard-freezes this firmware under evcc+BLE load — rejected Package B, see
# partitions.csv / CLAUDE.md).
CONFIG_ESP_COREDUMP_ENABLE_TO_NONE=y
