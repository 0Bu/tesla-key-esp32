menu "Tesla Key Configuration"

    config TESLA_WIFI_SSID
        string "WiFi SSID"
        default ""
        help
            SSID of the WiFi network to connect to.
            Leave empty to boot into the SoftAP setup portal ("tesla-key-esp32-setup")
            on first start, where WiFi + VIN can be entered from a phone.

    config TESLA_WIFI_PASSWORD
        string "WiFi Password"
        default ""
        help
            Password for the WiFi network.

    config TESLA_VIN
        string "Tesla Vehicle VIN"
        default ""
        help
            17-character VIN of your Tesla vehicle.
            Can also be set at runtime via NVS.

    config TESLA_BLE_MAC
        string "Tesla BLE MAC address (optional)"
        default ""
        help
            BLE MAC address of the vehicle (AA:BB:CC:DD:EE:FF). Informational only:
            the device always finds the car by its VIN-derived BLE advertising name
            (robust to Tesla's rotating BLE addresses), never by this MAC. The MAC
            discovered on first connect is saved to NVS ("ble_mac") for reference
            and forgotten again on a VIN change.

    config TESLA_OTA_MANIFEST_URL
        string "OTA manifest URL"
        default "https://0bu.github.io/tesla-key-esp32/manifest.json"
        help
            HTTPS URL of the manifest.json published by CI. Its "version" field is
            compared against the running firmware to decide whether an update is
            available. Must be HTTPS (verified against the bundled CA roots).

    config TESLA_OTA_FIRMWARE_BASE_URL
        string "OTA firmware base URL (directory)"
        default "https://0bu.github.io/tesla-key-esp32/"
        help
            HTTPS base URL (a directory, with trailing slash) where the per-target app
            images are published. The device appends "tesla-key-esp32<suffix>.bin" for
            its own chip — <suffix> is "" / -s3 / -c3 / -c6 (so "esp32" appears once),
            picked at compile time — one channel serves every supported target.
            The image is downloaded and flashed to the inactive OTA slot by esp_https_ota,
            which also verifies the image chip-id and refuses a wrong-target image. Must
            be HTTPS (verified against the bundled CA roots).

    config TESLA_MQTT_BROKER_URI
        string "MQTT broker URI (Home Assistant)"
        default ""
        help
            MQTT broker for the Home Assistant telemetry bridge, e.g.
            "mqtt://192.168.1.10:1883". A bare "host:port" is also accepted.
            Leave empty to disable MQTT. Can be set/changed at runtime in the web
            UI (Connection → MQTT), which stores it in NVS and overrides this.

    config TESLA_MQTT_USERNAME
        string "MQTT username (optional)"
        default ""
        help
            Username for the MQTT broker. Leave empty for an anonymous broker.

    config TESLA_MQTT_PASSWORD
        string "MQTT password (optional)"
        default ""
        help
            Password for the MQTT broker. Leave empty for an anonymous broker.

    config TESLA_MQTT_DISCOVERY_PREFIX
        string "Home Assistant MQTT discovery prefix"
        default "homeassistant"
        help
            Discovery topic prefix HA listens on. Default "homeassistant" matches
            the stock Home Assistant MQTT integration.

    config TESLA_MQTT_BASE_TOPIC
        string "MQTT base topic prefix"
        default "tesla-key"
        help
            Prefix for state topics. The vehicle-stable VIN node id is appended,
            e.g. "tesla-key/teslakey_5yj3e1ea7kf000316/charge".

    config TESLA_MQTT_PUBLISH_INTERVAL_S
        int "MQTT publish interval (seconds)"
        default 15
        range 5 600
        help
            How often the full set of cached telemetry + device status is
            republished to MQTT (retained). Discovery + an immediate snapshot are
            also sent on every (re)connect.

    config TESLA_SYSLOG_SERVER
        string "Syslog server (host:port)"
        default ""
        help
            UDP Syslog collector for the device's diagnostic log (the same output
            served by GET /diag and the serial console), e.g. "192.168.1.22:514". A
            bare host defaults to port 514. Leave empty to disable. Can be
            set/changed at runtime in the web UI (Connections -> Syslog), which
            stores it in NVS ("syslog_uri") and overrides this.

    # ── Ethernet (W5500 over SPI — the M5Stack ATOMIC PoE Base) ──────────────────────────────
    # OFF by default and enabled per target, for two independent reasons. (1) Flash: compiling
    # in esp_eth + the W5500 driver costs tens of KB, and esp32c6 has only ~92 KB of headroom
    # under the ci-build-all.sh size gate, where growth is quantised to 64 KB Secure-Boot blocks.
    # (2) Pins: the probe drives SPI on real GPIOs, which is only safe on a board known not to
    # have something else there. It is enabled for esp32s3 (sdkconfig.defaults.esp32s3), whose
    # ONE image also serves the T-Dongle-S3 — net.cpp refuses to probe on that board because its
    # panel clock IS the W5500's SCK pin (see tk::board_is_t_dongle_s3()).
    config TESLA_ETH_ENABLED
        bool "Enable Ethernet (W5500 over SPI)"
        default n
        select ETH_USE_SPI_ETHERNET
        select ETH_SPI_ETHERNET_W5500
        help
            Compile in an SPI Ethernet transport (WIZnet W5500 in MAC-RAW mode) as an
            alternative to WiFi. At boot the firmware probes for the controller; only a board
            that actually answers gets an Ethernet netif, so this is safe to enable for a
            target whose image also runs on boards without one.

            When a wire carries the lease the WiFi stack is never started at all — which frees
            its heap AND removes WiFi/BLE radio coexistence, the constraint that forces
            WIFI_PS_MIN_MODEM and slows every BLE round-trip to the car.

    # Defaults are the M5Stack AtomS3 Lite + ATOMIC PoE Base wiring (the base routes only these
    # four signals plus power — there is no INT and no RST line, hence the polling mode below).
    config TESLA_ETH_SPI_SCLK
        int "W5500 SPI SCLK GPIO"
        depends on TESLA_ETH_ENABLED
        default 5
    config TESLA_ETH_SPI_CS
        int "W5500 SPI CS GPIO"
        depends on TESLA_ETH_ENABLED
        default 6
    config TESLA_ETH_SPI_MISO
        int "W5500 SPI MISO GPIO"
        depends on TESLA_ETH_ENABLED
        default 7
    config TESLA_ETH_SPI_MOSI
        int "W5500 SPI MOSI GPIO"
        depends on TESLA_ETH_ENABLED
        default 8
    config TESLA_ETH_SPI_CLOCK_MHZ
        int "W5500 SPI clock (MHz)"
        depends on TESLA_ETH_ENABLED
        range 4 40
        default 20
        help
            20 MHz is the value Espressif's own W5500 CI configuration uses. The part is
            specified far higher, but on the short unshielded stack-through headers these
            bases use, faster clocks are where the intermittent RX corruption reports start.

    config TESLA_ETH_POLL_MS
        int "W5500 poll period (ms) — no INT line is routed"
        depends on TESLA_ETH_ENABLED
        range 1 100
        default 10
        help
            The ATOMIC PoE Base brings out only SCLK/CS/MISO/MOSI + power, so the W5500's
            interrupt line is unavailable and the driver must poll. 10 ms matches ESP-IDF's
            own polling-mode test configuration. It bounds RX latency, not throughput: each
            poll drains everything queued in the W5500's 16 KB RX buffer.

    config TESLA_ETH_WAIT_S
        int "Seconds to wait for a DHCP lease once the Ethernet LINK is up"
        depends on TESLA_ETH_ENABLED
        range 5 120
        default 20
        help
            Applies only once the PHY reports a connected cable. "Is a cable attached" is
            answered separately and much faster (a few seconds of link grace), so a board with
            no cable — and therefore possibly no way to be reached but the setup AP — does not
            sit dark for this whole window before that AP appears.

            When the link IS up, falling back early would run the WiFi stack for the rest of the
            boot on a board that is about to be wired, so this deadline is generous and is
            extended further while the link stays up.

    config TESLA_DISPLAY_ENABLED
        bool "On-device ST7735 status display (LilyGo T-Dongle-S3)"
        default n
        help
            Drive a 0.96" ST7735 80x160 SPI TFT and render the charge/connection
            status (SoC battery, charging state, WiFi/BLE) directly on the panel —
            mirroring the web UI. Reads ONLY cached state, so it never triggers a BLE
            round-trip (can't wake the car) and does not depend on MQTT. Off by default;
            enabled for the LilyGo T-Dongle-S3 (sdkconfig.defaults.esp32s3), which sets
            the pins below to that board's wiring. That build has no PSRAM, so the
            framebuffer is ~25 KB of internal SRAM, allocated once at boot. The single
            esp32s3 image auto-detects the dongle, so a generic ESP32-S3 keeps the panel
            disabled.

    if TESLA_DISPLAY_ENABLED
    # Defaults ARE the T-Dongle-S3 wiring — the only board this project drives a panel on.
    # sdkconfig.defaults.esp32s3 restates them explicitly so the shipped esp32s3 build does not
    # depend on a default, and the two must move together.
    config TESLA_DISPLAY_SPI_MOSI
        int "Display SPI MOSI (SDA) GPIO"
        default 3
    config TESLA_DISPLAY_SPI_SCK
        int "Display SPI SCK (SCL) GPIO"
        default 5
    config TESLA_DISPLAY_CS
        int "Display CS GPIO"
        default 4
    config TESLA_DISPLAY_DC
        int "Display DC (RS) GPIO"
        default 2
    config TESLA_DISPLAY_RST
        int "Display RST GPIO"
        default 1
    config TESLA_DISPLAY_BL
        int "Display backlight GPIO"
        default 38
    endif

    config TESLA_LED_ENABLED
        bool "On-device status LED (LilyGo T-Dongle underside APA102)"
        default n
        help
            Drive the single APA102 RGB pixel on the underside of a LilyGo T-Dongle-S3
            as a status indicator — WiFi/BLE search (breathing), pairing
            (pulse), charging (green swell), state-of-charge colour when parked, OTA
            in flight, and amber/red for warnings/errors. Reads ONLY cached state, so
            it never triggers a BLE round-trip (can't wake the car) and needs no MQTT;
            it also works on a board with no display. Off by default — not every
            ESP32-S3 board carries this LED, so enable it per board. The defaults below are
            the T-Dongle-S3 wiring (DI=40, CI=39) — nothing overrides them in a
            sdkconfig.defaults, so on any other board set both pins by hand.

    if TESLA_LED_ENABLED
    config TESLA_LED_DI_GPIO
        int "APA102 data (DI) GPIO"
        default 40
    config TESLA_LED_CI_GPIO
        int "APA102 clock (CI) GPIO"
        default 39
    config TESLA_LED_BRIGHTNESS
        int "APA102 global brightness (1-31)"
        default 8
        range 1 31
        help
            APA102 5-bit global brightness. Kept low by default so the indicator isn't
            a glaring dot on a desk and draws little current; resting states (parked
            SoC) dim further in firmware.
    endif

endmenu
